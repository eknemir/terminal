{
  "name": "terminal-app",
  "productName": "Terminal",
  "version": "0.15.3",
  "description": "Derin Terminal: Claude Code oturumları için HUD, dikey video önizleme, efekt presetleri ve skill yöneticisi",
  "author": "eknemir",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "staging": "node scripts/staging.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "node scripts/fetch-rtk.js && electron-builder --win --publish never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ersan.terminal",
    "productName": "Terminal",
    "artifactName": "Terminal-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "src/**",
      "pages/**",
      "package.json",
      "!**/*.pdb",
      "!node_modules/node-pty/prebuilds/darwin-*/**"
    ],
    "extraResources": [
      {
        "from": "../app/Resources/web",
        "to": "web"
      },
      {
        "from": "../app/Resources/caveman",
        "to": "caveman"
      },
      {
        "from": "../skills",
        "to": "skills"
      },
      {
        "from": "vendor/rtk",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Derin Terminal",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/derin-icon.ico",
      "uninstallerIcon": "build/derin-icon.ico",
      "installerHeaderIcon": "build/derin-icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/eknemir/terminal/releases/download/windows"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
