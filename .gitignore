# The API is its own (private) repo: atalay-terminal-api
/api/
.DS_Store
# Users' raw feedback stays on this Mac (the repo is public); CHANGELOG has the feature notes.
/feedback/
/app/orbit/node_modules/
# The Windows app: its packages, its builds, and the key its API calls are signed with (made at build time)
/windows/node_modules/
/windows/dist/
/windows/src/clientkey.js
/app/vendor/
/windows/vendor/
# Claude Code's own files (skills for the release PCs) stay on those machines, never in this public repo
/.claude/

# Secrets and signing material never go to this public repo
.env
.env.*
*.pem
*.p12
*.key
*.mobileprovision
# Build output and scratch
dist/
**/build/*.app
/app/build/release/
/app/build/dmg/
/app/.build/
/app/.build-x86_64/
/coverage/
node_modules/
*.log
*.tmp
*.bak
*.orig
scratch/
.scratch/
Thumbs.db

tests/e2e/out/
